@model ErrorViewModel
@{
    ViewData["Title"] = "System Error - NUML FYP Match Tracker";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
                <div class="rounded-circle bg-warning-subtle text-warning mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-octagon-fill fs-1"></i>
                </div>
                
                <h3 class="fw-bold mb-2" style="color: var(--numl-navy);">Unexpected Request Issue</h3>
                <p class="text-muted small mb-4">
                    An error occurred while processing your request. The system has safely logged this event. Please return to the homepage or try your check again.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="p-2 bg-light rounded-3 mb-4 border font-monospace small text-muted">
                        Request ID: @Model.RequestId
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-medium" style="background-color: var(--numl-navy);">
                        <i class="bi bi-house-door me-1"></i> Back to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
