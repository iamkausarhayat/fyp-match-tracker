@{
    ViewData["Title"] = "Access Denied - NUML FYP Match Tracker";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 text-center">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
                <div class="rounded-circle bg-danger-subtle text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </div>
                
                <h3 class="fw-bold mb-2" style="color: var(--numl-navy);">Access Restricted</h3>
                <p class="text-muted small mb-4">
                    You do not have the required permissions to access this administrative portal or resource. Please sign in with an authorized Coordinator account.
                </p>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                        <i class="bi bi-arrow-left me-1"></i> Return to Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill py-2 fw-medium" style="background-color: var(--numl-navy);">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
