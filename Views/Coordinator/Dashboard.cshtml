@model List<FypMatchTracker.Models.SimilarityCheck>
@{
    ViewData["Title"] = "Coordinator Analytics Dashboard - NUML";
    var yearLabels = ViewBag.YearLabels as List<string> ?? new List<string>();
    var yearCounts = ViewBag.YearCounts as List<int> ?? new List<int>();
    var verdictCounts = ViewBag.VerdictCounts as List<int> ?? new List<int> { 0, 0, 0 };
    var topKeywords = ViewBag.TopKeywords as dynamic;
    var supervisorLoad = ViewBag.SupervisorLoad as dynamic;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--numl-navy);">FYP Coordinator Analytics</h3>
            <p class="text-muted small mb-0">Departmental metrics, similarity check trends, and archive distribution</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Library" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-collection me-1"></i> Manage Archive
            </a>
            <a asp-action="Settings" class="btn btn-primary btn-sm rounded-pill px-3" style="background-color: var(--numl-navy);">
                <i class="bi bi-sliders me-1"></i> Algorithm Settings
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1 -->
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                        <i class="bi bi-database-check fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Archive Projects</span>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalProjects</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info-subtle text-info">
                        <i class="bi bi-speedometer fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Checks Conducted</span>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalChecks</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-danger-subtle text-danger">
                        <i class="bi bi-shield-x fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Duplicates Flagged</span>
                        <h3 class="fw-bold mb-0 text-danger">@ViewBag.HighRiskChecks</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success-subtle text-success">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Avg. Similarity</span>
                        <h3 class="fw-bold mb-0 text-success">@ViewBag.AvgScore%</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Archive Growth -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h6 class="fw-bold mb-3 text-secondary text-uppercase small">
                    <i class="bi bi-bar-chart-line text-primary me-2"></i> Department FYPs Archived by Academic Year
                </h6>
                <div style="height: 250px;">
                    <canvas id="yearlyChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Verdict Breakdown -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h6 class="fw-bold mb-3 text-secondary text-uppercase small">
                    <i class="bi bi-pie-chart text-info me-2"></i> Verdict Distribution Breakdown
                </h6>
                <div style="height: 250px;" class="d-flex align-items-center justify-content-center">
                    <canvas id="verdictChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Keywords & Recent Checks -->
    <div class="row g-4">
        <!-- Left Column: Keywords & Faculty Supervision Load -->
        <div class="col-lg-4 d-flex flex-column gap-4">
            <!-- Top Keywords Cloud -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold mb-3 text-secondary text-uppercase small">
                    <i class="bi bi-tags text-success me-2"></i> Frequent Repository Keywords
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @if (topKeywords != null)
                    {
                        foreach (var item in topKeywords)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill font-monospace" style="font-size: 0.8rem;">
                                @item.Keyword <span class="badge bg-secondary ms-1">@item.Count</span>
                            </span>
                        }
                    }
                </div>
            </div>

            <!-- Faculty Supervision Allocation (Load Balance) -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-secondary text-uppercase small">
                        <i class="bi bi-person-check text-primary me-2"></i> Faculty Supervision Load
                    </h6>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Distribution</span>
                </div>
                @if (supervisorLoad != null)
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var item in supervisorLoad)
                        {
                            <div class="d-flex justify-content-between align-items-center small p-2 bg-light rounded-3 border">
                                <span class="fw-semibold text-dark text-truncate" style="max-width: 190px;" title="@item.Supervisor">
                                    <i class="bi bi-person-badge text-secondary me-1"></i>@item.Supervisor
                                </span>
                                <span class="badge bg-primary rounded-pill font-monospace">@item.Count FYPs</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Recent Checks Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-secondary text-uppercase small">
                        <i class="bi bi-clock-history text-primary me-2"></i> Recent Student Similarity Evaluations
                    </h6>
                    <span class="badge bg-light text-muted border">Latest Checks</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-secondary">
                                <th>Student</th>
                                <th>University</th>
                                <th>Proposed Title</th>
                                <th>Supervisor</th>
                                <th>Score</th>
                                <th>Verdict</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var check in Model)
                            {
                                string badgeClass = check.Verdict switch
                                {
                                    "UNIQUE" => "bg-success text-white",
                                    "SIMILAR" => "bg-warning text-dark",
                                    _ => "bg-danger text-white"
                                };

                                string studentDisplayName = check.Student?.FullName ?? check.StudentName ?? "Guest Student";
                                string studentUniversity = check.UniversityName ?? check.Student?.University ?? "NUML Islamabad";

                                <tr>
                                    <td class="small">
                                        <strong class="d-block text-dark">@studentDisplayName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace small">@studentUniversity</span>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate text-dark" style="max-width: 220px;" title="@check.SubmittedTitle">
                                            @check.SubmittedTitle
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        <i class="bi bi-person me-1"></i>@(check.SupervisorName ?? "Not Assigned")
                                    </td>
                                    <td class="font-monospace fw-bold">@check.TopScore%</td>
                                    <td>
                                        <span class="badge @badgeClass text-uppercase font-monospace">@check.Verdict</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Home" asp-action="Report" asp-route-id="@check.Id" class="btn btn-outline-primary btn-sm rounded-pill px-2.5">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Yearly Bar Chart
    const ctxYear = document.getElementById('yearlyChart').getContext('2d');
    new Chart(ctxYear, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(yearLabels)),
            datasets: [{
                label: 'Archived FYPs',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(yearCounts)),
                backgroundColor: '#134074',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });

    // Verdict Doughnut Chart
    const ctxVerdict = document.getElementById('verdictChart').getContext('2d');
    new Chart(ctxVerdict, {
        type: 'doughnut',
        data: {
            labels: ['UNIQUE', 'SIMILAR', 'ALREADY DONE'],
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(verdictCounts)),
                backgroundColor: ['#198754', '#D97706', '#DC3545'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
