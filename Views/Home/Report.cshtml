@model FypMatchTracker.Models.SimilarityCheck
@{
    ViewData["Title"] = "Similarity Assessment Report - " + Model.SubmittedTitle;
    var settings = ViewBag.Settings as FypMatchTracker.Models.SimilaritySetting ?? new FypMatchTracker.Models.SimilaritySetting();
    var internalMatches = (ViewBag.InternalMatches as List<FypMatchTracker.Models.SimilarityMatch> ?? new List<FypMatchTracker.Models.SimilarityMatch>())
        .Where(m => m.FinalScore >= 10.0)
        .ToList();
    var externalMatches = (ViewBag.ExternalMatches as List<FypMatchTracker.Models.SimilarityMatch> ?? new List<FypMatchTracker.Models.SimilarityMatch>())
        .Where(m => m.FinalScore >= 10.0)
        .ToList();
    var topMatch = ViewBag.TopMatch as FypMatchTracker.Models.SimilarityMatch;
    bool isAlreadyReserved = ViewBag.IsAlreadyReserved ?? false;

    // Verdict color mappings
    string verdictBadgeClass = Model.Verdict switch
    {
        "UNIQUE" => "bg-success text-white",
        "SIMILAR" => "bg-warning text-dark",
        _ => "bg-danger text-white"
    };

    string verdictColorHex = Model.Verdict switch
    {
        "UNIQUE" => "#198754",
        "SIMILAR" => "#D97706",
        _ => "#DC3545"
    };

    string verdictDescription = Model.Verdict switch
    {
        "UNIQUE" => "Low similarity detected. This proposal appears original and does not duplicate known department or international projects.",
        "SIMILAR" => "Moderate overlap found. The core methodology or problem statement partially overlaps with existing work. Consider refining your angle.",
        _ => "High duplication detected! This idea strongly mirrors a completed project in the department archive or published literature. Significant differentiation is required."
    };

    // Calculate SVG circle stroke-dashoffset (circumference = 2 * PI * 45 = 282.74)
    double circumference = 282.74;
    double offset = circumference - (Model.TopScore / 100.0 * circumference);
    var reservedProject = ViewBag.ReservedProject as FypMatchTracker.Models.FypProject;
    var suggestions = ViewBag.Suggestions as List<string> ?? new List<string>();
}

<style>
    @@media print {
        body {
            background-color: #ffffff !important;
            font-size: 11pt;
            color: #000000 !important;
        }
        .navbar, .btn, .modal, footer, .d-print-none, #compareModal, #reserveModal {
            display: none !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
        }
        .card {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            break-inside: avoid;
            margin-bottom: 15px !important;
        }
        .print-only-header {
            display: block !important;
            border-bottom: 2px solid #1a365d;
            padding-bottom: 10px;
            margin-bottom: 20px;
            text-align: center;
        }
        .signature-box {
            display: flex !important;
            justify-content: space-between;
            margin-top: 40px;
            page-break-inside: avoid;
        }
    }
    .print-only-header, .signature-box {
        display: none;
    }
</style>

<div class="container py-4">
    <!-- Print Only University Header -->
    <div class="print-only-header">
        <h3 class="fw-bold text-uppercase mb-1" style="color: #1a365d; letter-spacing: 0.5px;">National University of Modern Languages</h3>
        <h6 class="text-secondary mb-1">Department of Computer Science &bull; Islamabad</h6>
        <h5 class="fw-bold text-dark mt-2 mb-0">FYP Originality & Novelty Assessment Certificate</h5>
        <small class="text-muted font-monospace">Generated by NUML FYP Match Tracker Engine &bull; Academic Session 2026</small>
    </div>

    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Check Another Idea
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-light btn-sm rounded-pill border px-3">
                <i class="bi bi-printer me-1"></i> Print Clearance Report (PDF)
            </button>
            <a asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3" style="background-color: var(--numl-navy);">
                <i class="bi bi-plus-circle me-1"></i> New Submission
            </a>
        </div>
    </div>

    <!-- Section 1: Checked Idea Overview -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-light text-primary border px-3 py-1 font-monospace">@(Model.UniversityName ?? Model.Student?.University ?? "NUML Islamabad")</span>
                <span class="badge bg-light text-dark border px-3 py-1 font-monospace">@Model.DepartmentName</span>
                <span class="badge bg-light text-secondary border font-monospace">Check #@Model.Id</span>
            </div>
            <div class="small text-muted">
                <span class="me-2"><i class="bi bi-person-fill text-primary me-1"></i>@(Model.Student?.FullName ?? Model.StudentName ?? "Student")</span>
                <i class="bi bi-clock me-1"></i> @Model.CheckedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
            </div>
        </div>

        <h3 class="fw-bold mb-2" style="color: var(--numl-navy);">@Model.SubmittedTitle</h3>
        <p class="text-muted mb-3" style="font-size: 0.95rem; line-height: 1.6;">
            @Model.SubmittedText
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.SubmittedKeywords))
        {
            <div class="d-flex flex-wrap align-items-center gap-1">
                <small class="text-secondary fw-bold me-2">Keywords / Tools:</small>
                @foreach (var kw in Model.SubmittedKeywords.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                {
                    <span class="badge bg-light text-dark border">@kw</span>
                }
            </div>
        }
    </div>

    <!-- Section 2: Verdict & Circular Score Gauge -->
    <div class="row g-4 mb-4">
        <!-- Left: Gauge Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center h-100 d-flex flex-col justify-content-center">
                <h6 class="text-uppercase fw-bold text-muted small mb-3">Overall Similarity Score</h6>
                
                <div class="position-relative d-inline-block mx-auto mb-3" style="width: 170px; height: 170px;">
                    <svg class="w-100 h-100" viewBox="0 0 100 100" style="transform: rotate(-90deg);">
                        <!-- Background Circle -->
                        <circle cx="50" cy="50" r="45" stroke="#E2E8F0" stroke-width="8" fill="none"></circle>
                        <!-- Progress Circle -->
                        <circle cx="50" cy="50" r="45" stroke="@verdictColorHex" stroke-width="8" fill="none"
                                stroke-dasharray="@circumference" stroke-dashoffset="@offset" stroke-linecap="round"></circle>
                    </svg>
                    <!-- Center Percentage Text -->
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <span class="display-6 fw-bold d-block" style="color: @verdictColorHex;">@Model.TopScore%</span>
                        <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Top Match</small>
                    </div>
                </div>

                <!-- Verdict Badge -->
                <div>
                    <span class="badge @verdictBadgeClass fs-6 px-4 py-2 rounded-pill shadow-xs text-uppercase fw-bold">
                        @Model.Verdict
                    </span>
                    <p class="text-muted small mt-2 mb-0 px-3">
                        @verdictDescription
                    </p>
                </div>
            </div>
        </div>

        <!-- Right: AI Evaluation Formula Breakdown -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold mb-3" style="color: var(--numl-navy);">
                    <i class="bi bi-diagram-3 text-primary me-2"></i> Hybrid Similarity Breakdown
                </h5>
                <p class="text-muted small mb-3">
                    As per the FYP Match Tracker architecture, overall similarity is calculated using a weighted combination of semantic embeddings and Jaccard keyword matching:
                </p>

                @{
                    int semPct = (int)Math.Round(settings.SemanticWeight > 1.0 ? settings.SemanticWeight : settings.SemanticWeight * 100);
                    int keyPct = (int)Math.Round(settings.KeywordWeight > 1.0 ? settings.KeywordWeight : settings.KeywordWeight * 100);
                }

                @if (topMatch != null)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span>Semantic Meaning Match (@semPct%)</span>
                            <span class="text-primary font-monospace">@topMatch.SemanticScore%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @topMatch.SemanticScore%;"></div>
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">Calculated via 384-dimensional cosine similarity using the local ONNX model.</small>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span>Keyword Jaccard Overlap (@keyPct%)</span>
                            <span class="text-success font-monospace">@topMatch.KeywordScore%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @topMatch.KeywordScore%;"></div>
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">Intersection over union of technical terms with stop-word removal.</small>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <small class="text-secondary fw-semibold d-block mb-1">Final Weighted Formula:</small>
                        <code class="text-dark small d-block bg-white p-2 rounded border font-monospace">
                            FinalScore = (@semPct% &times; @topMatch.SemanticScore%) + (@keyPct% &times; @topMatch.KeywordScore%) = <strong>@topMatch.FinalScore%</strong>
                        </code>
                    </div>
                }
                else
                {
                    <div class="alert alert-success small mb-0">
                        <i class="bi bi-shield-check me-1"></i> No matching projects found above threshold. Your idea has 0% recorded duplication!
                    </div>
                }

                <!-- Reservation Action Card -->
                <div class="mt-4 pt-3 border-top">
                    @if (Model.Verdict == "UNIQUE")
                    {
                        @if (isAlreadyReserved && reservedProject != null)
                        {
                            <div class="alert alert-success border-success-subtle rounded-3 p-3 mb-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <span class="badge bg-success text-white px-3 py-1 font-monospace fs-6">
                                        <i class="bi bi-patch-check-fill me-1"></i> @reservedProject.ReservationToken
                                    </span>
                                    <span class="badge bg-white text-success border border-success-subtle fw-bold">
                                        Status: @reservedProject.Status
                                    </span>
                                </div>
                                <div class="small text-secondary mb-2">
                                    <strong>Supervisor:</strong> @(reservedProject.Supervisor ?? "Assigned by FYP Committee")
                                </div>
                                <button onclick="window.print()" class="btn btn-outline-success btn-sm rounded-pill px-3 w-100 fw-bold">
                                    <i class="bi bi-printer me-1"></i> Print Official Clearance Certificate
                                </button>
                            </div>
                        }
                        else if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Student"))
                        {
                            <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#reserveModal">
                                <i class="bi bi-bookmark-plus-fill"></i> Reserve This FYP Idea Now
                            </button>
                            <small class="text-muted d-block mt-1">Locks in your idea title and generates an official NUML Reservation Token.</small>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Report", "Home", new { id = Model.Id })" class="btn btn-outline-success rounded-pill px-4 fw-bold">
                                <i class="bi bi-lock me-1"></i> Sign In to Reserve This FYP Slot
                            </a>
                            <small class="text-muted d-block mt-1">Official slot reservation requires an institutional student account.</small>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">
                            <i class="bi bi-exclamation-circle text-warning me-1"></i> Only ideas with <strong>UNIQUE</strong> status can be reserved directly. For <strong>SIMILAR</strong> ideas, review the suggestions below and discuss adjustments with your FYP Coordinator.
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Section 2.5: Smart Novelty & Scope Suggestions (Assignment Module 6) -->
    @if (suggestions.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold mb-3" style="color: var(--numl-navy);">
                <i class="bi bi-lightbulb-fill text-warning me-2"></i> How to Make Your Proposal Distinct (Module 6 Guidance)
            </h5>
            <div class="row g-3">
                @foreach (var suggestion in suggestions)
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border-start border-3 border-primary">
                            <p class="small text-secondary mb-0" style="line-height: 1.5;">
                                <i class="bi bi-check2-circle text-primary me-1"></i> @suggestion
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Section 3: Department Archive Matches -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0" style="color: var(--numl-navy);">
                <i class="bi bi-mortarboard text-primary me-2"></i> NUML Department FYP Archive Matches (@internalMatches.Count)
            </h5>
            <span class="badge bg-light text-muted border">Local Database</span>
        </div>

        @if (internalMatches.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary">
                            <th>Matched Project Title</th>
                            <th>Year</th>
                            <th>Semantic</th>
                            <th>Keywords</th>
                            <th>Total Similarity</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in internalMatches)
                        {
                            var proj = match.FypProject;
                            if (proj == null) continue;

                            string badgeColor = match.FinalScore >= settings.HighThreshold ? "text-danger" :
                                                match.FinalScore >= settings.LowThreshold ? "text-warning" : "text-success";

                            <tr>
                                <td>
                                    <strong class="d-block text-dark">@proj.Title</strong>
                                    <small class="text-muted">@(proj.Description?.Length > 90 ? proj.Description.Substring(0, 90) + "..." : proj.Description)</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@proj.Year</span></td>
                                <td class="font-monospace small">@match.SemanticScore%</td>
                                <td class="font-monospace small">@match.KeywordScore%</td>
                                <td>
                                    <strong class="@badgeColor font-monospace fs-6">@match.FinalScore%</strong>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" 
                                            onclick="openCompareModal('@Html.Raw(JavaScriptEncoder.Default.Encode(proj.Title))', '@Html.Raw(JavaScriptEncoder.Default.Encode(proj.Description ?? ""))', @match.FinalScore)">
                                        <i class="bi bi-layout-split me-1"></i> Compare
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-check-circle fs-3 text-success d-block mb-2"></i>
                No close matches found in past departmental FYP archives.
            </div>
        }
    </div>

    <!-- Section 4: Crossref Global Research Literature Matches -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0" style="color: var(--numl-navy);">
                <i class="bi bi-globe2 text-info me-2"></i> International Research Papers (Crossref Web API) (@externalMatches.Count)
            </h5>
            <span class="badge bg-light text-muted border">Live Literature</span>
        </div>

        @if (externalMatches.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var match in externalMatches)
                {
                    var paper = match.ExternalPaper;
                    if (paper == null) continue;

                    <div class="list-group-item py-3 px-0">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">
                                    <a href="@paper.Url" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-dark">
                                        @paper.Title <i class="bi bi-box-arrow-up-right small text-muted"></i>
                                    </a>
                                </h6>
                                <p class="text-muted small mb-2" style="line-height: 1.5;">
                                    @(paper.Abstract?.Length > 180 ? paper.Abstract.Substring(0, 180) + "..." : paper.Abstract)
                                </p>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="badge bg-light text-secondary border font-monospace">DOI: @paper.Doi</span>
                                    <span class="badge bg-light text-secondary border">Year: @paper.Year</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light border text-primary fs-6 font-monospace">@match.FinalScore%</span>
                                <small class="text-muted d-block mt-1">Similarity</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-journal-check fs-3 text-info d-block mb-2"></i>
                No high-similarity international research papers found on Crossref.
            </div>
        }
    </div>

    <!-- Print-Only Clearance Signatures (Visible only during printing / PDF export) -->
    <div class="signature-box mt-5 pt-4">
        <div class="text-center" style="width: 250px;">
            <div style="border-bottom: 1.5px solid #000; height: 50px; margin-bottom: 8px;"></div>
            <strong class="d-block small text-dark">Proposed Supervisor</strong>
            <small class="text-muted">Signature &amp; Date</small>
        </div>
        <div class="text-center" style="width: 250px;">
            <div style="border-bottom: 1.5px solid #000; height: 50px; margin-bottom: 8px;"></div>
            <strong class="d-block small text-dark">FYP Coordinator (CS Dept)</strong>
            <small class="text-muted">Official Signature &amp; Stamp</small>
        </div>
    </div>
</div>

<!-- Modal: Side-by-Side Comparison -->
<div class="modal fade" id="compareModal" tabindex="-1" aria-labelledby="compareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="compareModalLabel">
                    <i class="bi bi-layout-split text-primary me-2"></i> Side-by-Side Proposal Comparison
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 p-2.5 px-3 bg-light rounded-3 border">
                    <span class="small fw-bold text-secondary">
                        <i class="bi bi-layout-split me-1 text-primary"></i> Proposal Comparison
                    </span>
                    <span class="badge bg-primary fs-6 font-monospace" id="modalSimilarityPill"></span>
                </div>

                <div class="row g-4">
                    <!-- Left: Student Submission -->
                    <div class="col-md-6 border-end">
                        <span class="badge bg-primary-subtle text-primary border mb-2">Student's Proposal</span>
                        <h6 class="fw-bold text-dark mb-2">@Model.SubmittedTitle</h6>
                        <div class="p-3 bg-light rounded-3 text-muted" style="font-size: 0.9rem; line-height: 1.6; max-height: 350px; overflow-y: auto;">
                            @Model.SubmittedText
                        </div>
                    </div>
                    <!-- Right: Matched Archive Project -->
                    <div class="col-md-6">
                        <span class="badge bg-secondary-subtle text-secondary border mb-2">Archive Matched FYP</span>
                        <h6 class="fw-bold text-dark mb-2" id="modalMatchedTitle"></h6>
                        <div class="p-3 bg-light rounded-3 text-muted" id="modalMatchedDesc" style="font-size: 0.9rem; line-height: 1.6; max-height: 350px; overflow-y: auto;">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Reserve Proposal with Supervisor -->
<div class="modal fade" id="reserveModal" tabindex="-1" aria-labelledby="reserveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Home" asp-action="ReserveIdea" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="checkId" value="@Model.Id" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="reserveModalLabel" style="color: var(--numl-navy);">
                        <i class="bi bi-bookmark-star-fill text-success me-2"></i> Reserve FYP Proposal
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-success-subtle border border-success-subtle text-success small mb-3">
                        <i class="bi bi-shield-check me-1"></i> <strong>Novelty Verified:</strong> Your proposal score (@Model.TopScore%) meets university originality criteria.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Project Title</label>
                        <input type="text" class="form-control form-control-sm bg-light fw-bold" value="@Model.SubmittedTitle" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Academic Department</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="@Model.DepartmentName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Proposed Supervisor (Optional)</label>
                        <input type="text" name="supervisor" class="form-control form-control-sm" placeholder="e.g. Ms. Ayesha Khalid, Dr. Muhammad Bilal" />
                        <small class="text-muted" style="font-size: 0.75rem;">If not finalized yet, coordinator will assign upon approval.</small>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 btn-sm fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Confirm &amp; Generate Token
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openCompareModal(title, description, score) {
        document.getElementById('modalMatchedTitle').textContent = title || '';
        document.getElementById('modalMatchedDesc').textContent = description || '';
        document.getElementById('modalSimilarityPill').textContent = 'Similarity Match: ' + score + '%';
        var modal = new bootstrap.Modal(document.getElementById('compareModal'));
        modal.show();
    }
</script>
}
